# Dependencies & build output (rebuilt inside the image)
/vendor
/node_modules
/public/build
/public/hot

# Local env: injected at runtime via `docker run --env-file`, never baked in.
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example

# Version control & IDE
.git
.gitignore
.gitattributes
.idea
.vscode
.fleet

# Laravel runtime / caches (keep the directories, drop generated files)
/storage/logs/*.log
bootstrap/cache/*.php

# Tests & tooling
/tests
phpunit.xml
.phpunit.result.cache
/.github

# Docker & misc
Dockerfile
.dockerignore
docker-compose*.yml
README.md
*.log
